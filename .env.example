# Copie este arquivo para .env e preencha com suas chaves reais:
#   cp .env.example .env
#
# As variáveis marcadas "só servidor" nunca devem ter o prefixo VITE_
# nem ser expostas ao navegador. Em produção, configure-as direto no
# painel da Vercel (Settings → Environment Variables) — nunca as
# commite no Git.

# URL do projeto Supabase (cliente e servidor)
VITE_SUPABASE_URL=

# Chave pública (anon) do Supabase — usada no navegador
VITE_SUPABASE_ANON_KEY=

# Chave secreta do Supabase (service_role) — só servidor, acesso total
# ao banco, ignora as políticas de RLS
SUPABASE_SERVICE_ROLE_KEY=

# Senha de acesso ao /admin — só servidor. Usada só como valor inicial:
# depois que a senha é trocada pelo próprio painel, o hash passa a ficar
# salvo no banco e essa variável deixa de ser consultada.
ADMIN_PASSWORD=

# String aleatória com 32+ caracteres — só servidor. Assina o cookie de
# sessão do admin, os tokens de confirmação por e-mail e as chaves de
# rate limit. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Chave da API do Resend — só servidor. Usada pra enviar o e-mail de
# aviso de reserva nova (pro dono) e o de aprovação/recusa (pro cliente).
RESEND_API_KEY=

# --- Opcionais: captcha discreto (Cloudflare Turnstile) ---
# Sem essas duas variáveis o formulário de reserva funciona normalmente,
# só sem captcha. Pra ativar, crie um site em
# https://dash.cloudflare.com/?to=/:account/turnstile

# Site key pública do Turnstile — cliente
VITE_TURNSTILE_SITE_KEY=

# Secret key do Turnstile — só servidor
TURNSTILE_SECRET_KEY=
